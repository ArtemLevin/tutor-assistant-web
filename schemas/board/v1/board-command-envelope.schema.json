            "$ref": "#/$defs/Identifier"
          },
          "type": "array",
          "uniqueItems": true
        },
        "schemaVersion": {
          "const": "1.0"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        }
