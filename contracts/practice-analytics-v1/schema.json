{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "practice-analytics-v1",
  "title": "Practice analytics competency metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceStudentKey", "sourceRevision", "generatedAt", "competencies"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceStudentKey": {"type": "string", "minLength": 1, "maxLength": 160},
    "sourceRevision": {"type": "string", "maxLength": 160},
    "generatedAt": {"type": "string", "format": "date-time"},
    "competencies": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["competencyId", "title", "groupTitle", "masteryLevel", "sourceLessonDate", "sourceLessonHref", "provider", "coverageStatus"],
        "properties": {
          "competencyId": {"type": "string", "minLength": 1, "maxLength": 160},
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "groupTitle": {"type": "string", "maxLength": 240},
          "masteryLevel": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
          "sourceLessonDate": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "sourceLessonHref": {"type": ["string", "null"], "maxLength": 512},
          "provider": {"type": ["string", "null"], "maxLength": 160},
          "coverageStatus": {"type": ["string", "null"], "maxLength": 80}
        }
      }
    }
  }
}
