{
	email {$ACME_EMAIL}
	admin 0.0.0.0:2019
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	@sensitive_join path /j/*
	@sensitive_ws path /api/v1/boards/*/collaboration
	log_skip @sensitive_join
	log_skip @sensitive_ws

	@board_api path /login /logout /j/* /api/v1/boards /api/v1/boards/* /health/* /metrics
	handle @board_api {
		reverse_proxy __BOARD_API_UPSTREAM__:8000 {
			health_uri /health/live
			health_interval 10s
			health_timeout 3s
		}
	}

	handle_path /board/* {
		reverse_proxy __TUTORBOARD_UPSTREAM__:8080 {
			health_uri /healthz
			health_interval 10s
			health_timeout 3s
		}
	}

	@board_spa path / /boards /boards/* /b/*
	handle @board_spa {
		reverse_proxy __TUTORBOARD_UPSTREAM__:8080 {
			health_uri /healthz
			health_interval 10s
			health_timeout 3s
		}
	}

	handle {
		respond "Not Found" 404
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	log {
		output stdout
		format json
	}
}
