COMPOSE_PROJECT_NAME=tutorboard-production
APP_DOMAIN=board.example.com
ACME_EMAIL=ops@example.com
PUBLIC_BASE_URL=https://board.example.com
TRUSTED_HOSTS=board.example.com
TRUSTED_PROXY_IPS=172.16.0.0/12

# All application images must be immutable digest references. Floating latest is forbidden.
BOARD_API_BLUE_IMAGE=ghcr.io/artemlevin/tutorboard-api:v1@sha256:REPLACE_WITH_DIGEST
BOARD_API_GREEN_IMAGE=ghcr.io/artemlevin/tutorboard-api:v1@sha256:REPLACE_WITH_DIGEST
BOARD_MIGRATION_IMAGE=ghcr.io/artemlevin/tutorboard-api:v1-migration@sha256:REPLACE_WITH_DIGEST
BOARD_OPS_IMAGE=ghcr.io/artemlevin/tutorboard-api:v1-ops@sha256:REPLACE_WITH_DIGEST
TUTORBOARD_BLUE_IMAGE=ghcr.io/artemlevin/tutorboard:v1-board@sha256:REPLACE_WITH_DIGEST
TUTORBOARD_GREEN_IMAGE=ghcr.io/artemlevin/tutorboard:v1-board@sha256:REPLACE_WITH_DIGEST

BOOTSTRAP_ORGANIZATION_NAME=TutorBoard
BOOTSTRAP_ORGANIZATION_SLUG=tutorboard
BOOTSTRAP_ADMIN_EMAIL=teacher@example.com
BOOTSTRAP_ADMIN_NAME=Owner

# Board snapshots/artifacts must use durable S3-compatible storage.
ARTIFACT_S3_ENDPOINT_URL=https://s3.example.invalid
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_BUCKET=tutorboard-snapshots
ARTIFACT_S3_ACCESS_KEY=replace-with-board-storage-access-key

# Backups must be off-host; do not point this at the same host-local storage.
BACKUP_S3_ENDPOINT_URL=https://backup-s3.example.invalid
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=tutorboard-backups
BACKUP_S3_PREFIX=tutorboard
BACKUP_S3_ACCESS_KEY=replace-with-dedicated-backup-access-key
BACKUP_RETENTION_DAYS=35
BACKUP_INTERVAL_SECONDS=79200

POSTGRES_DB=tutorboard
POSTGRES_USER=tutorboard
BOARD_COMMAND_MAX_SIZE_MB=5
BOARD_SNAPSHOT_MAX_SIZE_MB=50
BOARD_SNAPSHOT_INTERVAL_COMMANDS=100
BOARD_SNAPSHOT_INTERVAL_MB=5
BOARD_RETENTION_DAYS=365
BOARD_DELETE_GRACE_DAYS=30
RATE_LIMIT_BOARD_READS=600
RATE_LIMIT_BOARD_WRITES=300
RATE_LIMIT_INVITATIONS=120
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
