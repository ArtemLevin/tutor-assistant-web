#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - git
  - python3

users:
  - default
  - name: tutor-deploy
    gecos: TutorBoard deployment operator
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /etc/tutorboard/lockbox-secret-id
    owner: root:root
    permissions: "0644"
    content: |
      ${lockbox_secret_id}
  - path: /etc/tutorboard/provisioning-stage
    owner: root:root
    permissions: "0644"
    content: |
      cloud-init-complete

runcmd:
  - [systemctl, enable, --now, ssh.service]

final_message: "TutorBoard minimal cloud-init completed; continue with Ansible."
