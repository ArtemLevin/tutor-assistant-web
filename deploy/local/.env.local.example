COMPOSE_PROJECT_NAME=tutorboard-local
LOCAL_PORT=8080

# The three repositories must be siblings by default. Absolute paths are also accepted.
TUTORBOARD_CONTEXT=../tutorboard
GEOMETRYOS_CONTEXT=../geometryos

# RC component identity shown in image metadata.
TUTORBOARD_BUILD_VERSION=1.0.0-rc.1
TUTORBOARD_BUILD_REVISION=ad7c11d
GEOMETRYOS_BUILD_VERSION=0.3.0
GEOMETRYOS_BUILD_REVISION=84ae403

# Local-only credentials. Do not reuse them outside this Docker Desktop stack.
APP_SECRET_KEY=local-only-secret-key-32-characters
POSTGRES_PASSWORD=local-postgres-password
MINIO_ROOT_USER=tutor-local
MINIO_ROOT_PASSWORD=local-minio-password
BOOTSTRAP_ORGANIZATION_NAME=TutorBoard Local
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_NAME=Локальный администратор
BOOTSTRAP_ADMIN_PASSWORD=local-demo-password
